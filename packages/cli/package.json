{
  "name": "@usenexus/cli",
  "version": "0.1.0",
  "description": "nexus: a local GUI for Claude Code that runs the nexus loop on your repo. npx @usenexus/cli",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nexus": "bin/nexus.mjs"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "dist",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/bundle-prompts.mjs && vite build",
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node bin/nexus.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.305"
  },
  "devDependencies": {
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/quicksand": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jetbrains-mono": "1.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daretodave/nexus.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/daretodave/nexus#readme",
  "keywords": [
    "claude-code",
    "nexus",
    "autonomous",
    "agents",
    "methodology",
    "gui"
  ]
}
