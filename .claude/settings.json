{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git pull --ff-only:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(node scripts/verify.mjs:*)",
      "Bash(node scripts/pulse.mjs:*)",
      "Bash(node templates/scripts/loop-issue.mjs:*)",
      "Bash(node .claude/hooks/guard.mjs self-test)",
      "Bash(npm run verify:*)",
      "Bash(npm run deploy:check:*)",
      "Bash(node scripts/announce.mjs:*)",
      "Bash(node scripts/ledger.mjs:*)",
      "Bash(node scripts/worktree.mjs:*)",
      "Bash(node scripts/design/prompt.mjs:*)",
      "Bash(node scripts/design/ingest.mjs:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh label create:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git fetch:*)",
      "Bash(mktemp:*)",
      "Bash(echo:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git rebase:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git reset --keep:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin:*)",
      "Bash(git ls-tree:*)",
      "Bash(git -C:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge-base:*)",
      "Bash(git cat-file:*)",
      "Bash(git tag:*)",
      "Bash(git stash create:*)",
      "Bash(git update-ref:*)",
      "Bash(node scripts/claims.mjs:*)",
      "Bash(node scripts/plan/settle.mjs:*)",
      "Bash(node scripts/plan/progress.mjs:*)",
      "Bash(node scripts/plan/order.mjs:*)",
      "Bash(node scripts/plan/pending.mjs:*)",
      "Bash(node scripts/plan/settled.mjs:*)",
      "Bash(node scripts/plan/footguns.mjs:*)",
      "Bash(node scripts/plan-check.mjs:*)",
      "Bash(node scripts/owner.mjs:*)",
      "Bash(node scripts/install-hooks.mjs:*)",
      "Bash(node scripts/new-skill.mjs:*)",
      "Bash(node scripts/adopt-dryrun.mjs:*)",
      "Bash(npm run settle:*)",
      "Bash(npm run claims:*)",
      "Bash(npm run progress:*)",
      "Bash(npm run order:*)",
      "Bash(npm run announce:*)",
      "Bash(npm run ledger:*)",
      "Bash(npm run worktree:*)",
      "Bash(npm run pulse:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm pack:*)",
      "Bash(node --test:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(find:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(node -e:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.workspace)",
      "Read(../.env.workspace)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/steer.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs pre-bash"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs pre-read"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/steer.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/steer.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs stop"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/steer.mjs"
          }
        ]
      }
    ]
  }
}
